# Connexion Postgres (Vercel Postgres / Neon).
# En local, copier dans .env.local ; sur Vercel, la variable est fournie
# automatiquement par l'intégration Postgres.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Code d'accès à l'espace bureau (/resultats). À changer impérativement.
ADMIN_CODE=club-git-admin
